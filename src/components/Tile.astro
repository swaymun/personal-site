---
export interface Props {
  title: string;
  href?: string;
  size?: 'lg' | 'md' | 'sm';
  icon?: string;
  iconComponent?: any;
  color?: string;
  external?: boolean;
}

const {
  title,
  href = '#',
  size = 'md',
  icon,
  iconComponent,
  color = 'var(--xbox-green)',
  external = false,
} = Astro.props;

const Tag = href ? 'a' : 'div';
const linkProps = href && external
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<Tag
  href={href}
  class:list={['tile', `tile--${size}`]}
  style={`--tile-color: ${color}`}
  {...linkProps}
>
  <div class="tile-content">
    {icon && (
      <div class="tile-icon">
        <img src={icon} alt="" aria-hidden="true" />
      </div>
    )}
    {iconComponent && (
      <div class="tile-icon">
        <Fragment set:html={iconComponent} />
      </div>
    )}
    <slot />
  </div>
  <div class="tile-title">
    <span>{title}</span>
  </div>
</Tag>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    background-color: var(--tile-color);
    box-shadow: var(--shadow-tile);
    cursor: pointer;
    transition:
      transform var(--transition-normal),
      box-shadow var(--transition-normal);
    position: relative;
    overflow: hidden;
    text-decoration: none;
    color: var(--text-primary);
  }

  .tile:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: var(--shadow-tile-hover);
    z-index: var(--z-tile-hover);
  }

  .tile:focus-visible {
    outline: 3px solid var(--text-primary);
    outline-offset: 4px;
  }

  /* Size variants */
  .tile--lg {
    width: var(--tile-lg-width);
    height: var(--tile-lg-height);
  }

  .tile--md {
    width: var(--tile-md-width);
    height: var(--tile-md-height);
  }

  .tile--sm {
    width: var(--tile-sm-width);
    height: var(--tile-sm-height);
  }

  .tile-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
  }

  .tile-icon {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tile--lg .tile-icon {
    width: 100px;
    height: 100px;
  }

  .tile-icon img,
  .tile-icon :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    fill: currentColor;
  }

  .tile-title {
    background-color: var(--tile-title-bg);
    padding: var(--space-2) var(--space-3);
    min-height: var(--tile-title-height);
    display: flex;
    align-items: center;
  }

  .tile-title span {
    font-size: var(--text-base);
    font-weight: var(--font-weight-regular);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
