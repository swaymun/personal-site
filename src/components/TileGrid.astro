---
export interface Props {
  layout?: 'dashboard' | 'grid' | 'list';
}

const { layout = 'dashboard' } = Astro.props;
---

<div class:list={['tile-grid', `tile-grid--${layout}`]}>
  <slot />
</div>

<style>
  .tile-grid {
    display: flex;
    gap: var(--tile-gap);
    align-items: flex-start;
  }

  /* Dashboard layout - mimics Xbox 360 home screen */
  /* Large tile on left, smaller tiles in 2x2 grid on right */
  .tile-grid--dashboard {
    flex-wrap: nowrap;
  }

  /* Simple grid layout */
  .tile-grid--grid {
    flex-wrap: wrap;
    justify-content: center;
    max-width: 1200px;
  }

  /* List layout for projects page */
  .tile-grid--list {
    flex-direction: column;
    align-items: stretch;
    max-width: 800px;
    width: 100%;
  }

  /* Responsive adjustments */
  @media (max-width: 1024px) {
    .tile-grid--dashboard {
      flex-wrap: wrap;
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .tile-grid {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
