---
interface Props {
  gamertag: string;
  avatarSrc?: string;
}

const {
  gamertag,
  avatarSrc = '/logos/profile_pic.jpeg',
} = Astro.props;
---

<button class="gamertag-card" id="gamertag-card" aria-label="Open guide menu">
  <span class="gamertag-text" id="gamertag-text" data-gamertag={gamertag}>{gamertag}</span>
  <div class="gamertag-avatar">
    <img src={avatarSrc} alt={`${gamertag}'s avatar`} loading="lazy" />
  </div>
</button>

<style>
  .gamertag-card {
    display: flex;
    align-items: center;
    gap: 10px;
    background: none;
    padding: 0;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.15s ease;
  }

  .gamertag-card:hover {
    opacity: 0.85;
  }

  .gamertag-card:active {
    transform: scale(0.98);
  }

  .gamertag-avatar {
    width: 56px;
    height: 56px;
    border-radius: 6px;
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.4);
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .gamertag-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gamertag-text {
    font-size: 20px;
    color: #ffffff;
    font-weight: 400;
    font-family: 'Segoe UI', system-ui, sans-serif;
    transition: opacity 0.3s ease;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
    min-width: 90px;
    text-align: right;
  }

  .gamertag-text.fade {
    opacity: 0;
  }

  .gamertag-text.gamerscore {
    color: #9ACD32;
  }

  @media (max-width: 600px) {
    .gamertag-text {
      display: none;
    }

    .gamertag-avatar {
      width: 36px;
      height: 36px;
    }
  }
</style>

<script>
  import { audioManager } from '@/lib/audio/AudioManager';
  import { achievementManager } from '@/lib/achievements/AchievementManager';

  const card = document.getElementById('gamertag-card');
  const textEl = document.getElementById('gamertag-text') as HTMLElement;
  const gamertag = textEl?.dataset.gamertag || 'SwagMan67';

  let showingGamerscore = false;
  let rotationInterval: ReturnType<typeof setInterval> | null = null;

  function updateText() {
    if (!textEl) return;

    // Fade out
    textEl.classList.add('fade');

    setTimeout(() => {
      if (showingGamerscore) {
        textEl.textContent = gamertag;
        textEl.classList.remove('gamerscore');
      } else {
        const score = achievementManager.getTotalGamerscore();
        textEl.textContent = `${score}G`;
        textEl.classList.add('gamerscore');
      }
      showingGamerscore = !showingGamerscore;

      // Fade in
      textEl.classList.remove('fade');
    }, 300);
  }

  // Start rotation after boot
  function startRotation() {
    if (rotationInterval) return; // Prevent multiple intervals
    rotationInterval = setInterval(updateText, 3000);
  }

  window.addEventListener('boot-complete', () => {
    setTimeout(startRotation, 1000);
  });

  // Fallback
  setTimeout(() => {
    startRotation();
  }, 7000);

  // Click to open guide
  card?.addEventListener('click', () => {
    audioManager.play('select');
    // Dispatch event to open guide
    const guide = document.getElementById('guide-overlay');
    if (guide) {
      guide.classList.add('open');
      audioManager.play('guide-open');
      achievementManager.trackInteraction('guide-open');
    }
  });
</script>
