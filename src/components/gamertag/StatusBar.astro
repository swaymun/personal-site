---
import GamertagCard from './GamertagCard.astro';

interface Props {
  avatarSrc?: string;
}

const {
  avatarSrc = '/avatar/avatar-prof.png',
} = Astro.props;
---

<div class="status-bar" id="status-bar">
  <GamertagCard gamertag="SwagMan67" avatarSrc={avatarSrc} />
</div>

<style>
  .status-bar {
    position: fixed;
    top: 24px;
    right: 32px;
    display: flex;
    align-items: center;
    gap: 16px;
    z-index: 150;
    opacity: 0;
    transform: translateY(-10px);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }

  .status-bar.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 768px) {
    .status-bar {
      top: 12px;
      right: 12px;
    }
  }
</style>

<script>
  // Show status bar after boot sequence
  const statusBar = document.getElementById('status-bar');

  function showStatusBar() {
    setTimeout(() => {
      statusBar?.classList.add('visible');
    }, 300);
  }

  // Listen for boot complete event
  window.addEventListener('boot-complete', showStatusBar);

  // Also show immediately if boot was skipped
  if (document.getElementById('boot-sequence')?.classList.contains('removed')) {
    showStatusBar();
  }

  // Fallback: show after a delay if no boot sequence
  setTimeout(() => {
    if (!statusBar?.classList.contains('visible')) {
      showStatusBar();
    }
  }, 6000);
</script>
