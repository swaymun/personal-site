---
/**
 * SmallTileGroup - A 2x2 grid of small tiles
 * Used alongside a large tile in the dashboard layout
 */
---

<div class="small-tile-group">
  <slot />
</div>

<style>
  .small-tile-group {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: var(--tile-gap);
  }

  /* Ensure tiles fit the grid */
  .small-tile-group :global(.tile--md),
  .small-tile-group :global(.tile--sm) {
    width: 100%;
    height: auto;
    aspect-ratio: 1.1;
    min-height: 160px;
  }
</style>
