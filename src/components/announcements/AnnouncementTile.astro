---
interface Props {
  latestVersion?: string;
  latestTitle?: string;
  unreadCount?: number;
}

const { latestVersion = 'v1.0.0', latestTitle = 'Updates', unreadCount = 0 } = Astro.props;
---

<button class="announcement-tile" id="announcement-tile" data-unread={unreadCount}>
  <div class="tile-inner">
    <div class="tile-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
      </svg>
    </div>
    <div class="tile-content">
      <span class="tile-title">What's New</span>
      <span class="tile-version">{latestVersion}</span>
    </div>
    {unreadCount > 0 && <div class="unread-indicator" aria-label={`${unreadCount} unread updates`}></div>}
  </div>
  <div class="tile-bar">Updates</div>
</button>

<style>
  .announcement-tile {
    background: var(--xbox-green, #107c10);
    border: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 200px;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    position: relative;
    text-align: left;
  }

  .announcement-tile:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.35);
  }

  .announcement-tile:focus {
    outline: none;
    box-shadow:
      0 0 0 3px rgba(16, 124, 16, 0.5),
      0 0 20px rgba(16, 124, 16, 0.4);
  }

  .tile-inner {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .tile-icon {
    width: 40px;
    height: 40px;
    color: #ffffff;
    opacity: 0.9;
  }

  .tile-icon svg {
    width: 100%;
    height: 100%;
  }

  .tile-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .tile-title {
    font-size: 18px;
    font-weight: 600;
    color: #ffffff;
    font-family: 'Segoe UI', system-ui, sans-serif;
  }

  .tile-version {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
    font-family: 'Segoe UI', system-ui, sans-serif;
  }

  .tile-bar {
    background: #0a5a0a;
    padding: 8px 16px;
    font-size: 14px;
    color: #ffffff;
    font-family: 'Segoe UI', system-ui, sans-serif;
  }

  .unread-indicator {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 12px;
    height: 12px;
    background: #7cb342;
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
    box-shadow: 0 0 8px rgba(124, 179, 66, 0.6);
  }

  @keyframes pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.2);
      opacity: 0.7;
    }
  }
</style>

<script>
  import { audioManager } from '@/lib/audio/AudioManager';

  const tile = document.getElementById('announcement-tile');

  tile?.addEventListener('click', () => {
    audioManager.play('select');
    // Open announcements modal
    const modal = document.getElementById('announcements-modal');
    modal?.classList.add('open');
    document.body.style.overflow = 'hidden';
  });
</script>
