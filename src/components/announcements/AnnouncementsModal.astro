---
import { getCollection } from 'astro:content';

// Get all announcements
const announcements = await getCollection('announcements', ({ data }) => {
  return data.draft !== true;
});

// Sort by date, newest first
const sortedAnnouncements = announcements.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// Get all announcement IDs for tracking
const announcementIds = sortedAnnouncements.map((a) => a.slug);

// Category labels
const categoryLabels: Record<string, string> = {
  'dev-updates': 'Dev Updates',
  'new-features': 'New Features',
  tips: 'Tips',
  personal: 'Personal',
};

const categoryColors: Record<string, string> = {
  'dev-updates': '#0078D7',
  'new-features': '#107C10',
  tips: '#FFB900',
  personal: '#9B4F96',
};
---

<div
  id="announcements-modal"
  class="announcements-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
  data-announcement-ids={JSON.stringify(announcementIds)}
>
  <div class="modal-backdrop"></div>
  <div class="modal-content">
    <div class="modal-header">
      <button class="back-button" id="modal-close">
        <span class="btn-icon btn-b">B</span>
        <span>Back</span>
      </button>
      <div class="modal-title-area">
        <h2 id="modal-title">What's New</h2>
        <span class="version-badge">{sortedAnnouncements[0]?.data.version || 'v1.0.0'}</span>
      </div>
    </div>

    <div class="modal-body">
      <div class="announcements-list">
        {
          sortedAnnouncements.map(async (announcement) => {
            const { Content } = await announcement.render();
            return (
              <article class="announcement-card" data-id={announcement.slug}>
                <div class="card-header">
                  <span
                    class="category-badge"
                    style={`background: ${categoryColors[announcement.data.category]}`}
                  >
                    {categoryLabels[announcement.data.category]}
                  </span>
                  <span class="version">{announcement.data.version}</span>
                  <span class="date">
                    {announcement.data.date.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric',
                    })}
                  </span>
                </div>
                <h3 class="card-title">{announcement.data.title}</h3>
                <div class="card-content">
                  <Content />
                </div>
              </article>
            );
          })
        }
      </div>
    </div>

    <div class="modal-footer">
      <div class="action-hint">
        <span class="btn-icon btn-a">A</span>
        <span>Select</span>
      </div>
      <div class="action-hint">
        <span class="btn-icon btn-b">B</span>
        <span>Back</span>
      </div>
    </div>
  </div>
</div>

<style>
  .announcements-modal {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
  }

  .announcements-modal.open {
    opacity: 1;
    visibility: visible;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(4px);
  }

  .modal-content {
    position: relative;
    width: 90%;
    max-width: 700px;
    max-height: 85vh;
    background: linear-gradient(180deg, #2a2a2a 0%, #1a1a1a 100%);
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.5),
      0 0 1px rgba(255, 255, 255, 0.1);
  }

  .announcements-modal.open .modal-content {
    transform: scale(1);
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .back-button {
    display: flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: none;
    color: #ffffff;
    cursor: pointer;
    font-size: 14px;
    font-family: 'Segoe UI', system-ui, sans-serif;
    padding: 8px 12px;
    border-radius: 4px;
    transition: background 0.2s ease;
  }

  .back-button:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .modal-title-area {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  #modal-title {
    font-size: 24px;
    font-weight: 300;
    color: #ffffff;
    margin: 0;
    font-family: 'Segoe UI', system-ui, sans-serif;
  }

  .version-badge {
    font-size: 12px;
    background: #107c10;
    color: #ffffff;
    padding: 4px 10px;
    border-radius: 2px;
    font-weight: 600;
  }

  .modal-body {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
  }

  /* Custom scrollbar */
  .modal-body::-webkit-scrollbar {
    width: 8px;
  }

  .modal-body::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
  }

  .modal-body::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
  }

  .modal-body::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .announcements-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .announcement-card {
    background: #f0f0f0;
    border-radius: 4px;
    overflow: hidden;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: #e0e0e0;
    border-bottom: 1px solid #d0d0d0;
  }

  .category-badge {
    font-size: 11px;
    color: #ffffff;
    padding: 3px 8px;
    border-radius: 2px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .version {
    font-size: 13px;
    color: #666;
    font-weight: 600;
  }

  .date {
    font-size: 12px;
    color: #888;
    margin-left: auto;
  }

  .card-title {
    font-size: 20px;
    font-weight: 600;
    color: #333;
    margin: 0;
    padding: 16px 16px 8px;
    font-family: 'Segoe UI', system-ui, sans-serif;
  }

  .card-content {
    padding: 0 16px 16px;
    color: #444;
    font-size: 14px;
    line-height: 1.6;
    font-family: 'Segoe UI', system-ui, sans-serif;
  }

  .card-content :global(h2) {
    font-size: 18px;
    font-weight: 600;
    color: #333;
    margin: 16px 0 8px;
  }

  .card-content :global(h3) {
    font-size: 16px;
    font-weight: 600;
    color: #444;
    margin: 12px 0 6px;
  }

  .card-content :global(ul) {
    margin: 8px 0;
    padding-left: 20px;
  }

  .card-content :global(li) {
    margin: 4px 0;
  }

  .card-content :global(p) {
    margin: 8px 0;
  }

  .modal-footer {
    display: flex;
    justify-content: center;
    gap: 24px;
    padding: 16px 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .action-hint {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #888;
    font-family: 'Segoe UI', system-ui, sans-serif;
  }

  .btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    font-size: 11px;
    font-weight: 700;
  }

  .btn-a {
    background: #107c10;
    color: #fff;
  }
  .btn-b {
    background: #e81123;
    color: #fff;
  }

  @media (max-width: 640px) {
    .modal-content {
      width: 95%;
      max-height: 90vh;
    }

    .modal-header {
      padding: 16px;
    }

    #modal-title {
      font-size: 18px;
    }

    .modal-body {
      padding: 16px;
    }
  }
</style>

<script>
  import { audioManager } from '@/lib/audio/AudioManager';
  import { markAllAsViewed } from '@/lib/announcements';

  const modal = document.getElementById('announcements-modal');
  const closeBtn = document.getElementById('modal-close');
  const backdrop = modal?.querySelector('.modal-backdrop');

  function closeModal() {
    audioManager.play('back');
    modal?.classList.remove('open');
    document.body.style.overflow = '';

    // Mark all as viewed when closing
    const idsData = modal?.dataset.announcementIds;
    if (idsData) {
      try {
        const ids = JSON.parse(idsData);
        markAllAsViewed(ids);

        // Update tile unread indicator
        const tile = document.getElementById('announcement-tile');
        const indicator = tile?.querySelector('.unread-indicator');
        indicator?.remove();
      } catch (e) {
        // Ignore parse errors
      }
    }
  }

  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);

  // Keyboard handling
  document.addEventListener('keydown', (e) => {
    if (!modal?.classList.contains('open')) return;

    if (e.key === 'Escape' || e.key === 'b' || e.key === 'B') {
      closeModal();
    }
  });
</script>
