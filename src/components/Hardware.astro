---
import type { devices } from "../data/site";
interface Props {
  device: (typeof devices)[number];
}
const { device: d } = Astro.props;
const id = d.id;
const screws =
  id === "gba"
    ? [
        [28, 25],
        [332, 25],
        [28, 267],
        [332, 267],
        [28, 603],
        [332, 603],
      ]
    : id === "3ds"
      ? [
          [35, 25],
          [485, 25],
          [35, 279],
          [485, 279],
