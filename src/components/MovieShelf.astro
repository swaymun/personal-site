---
import { movies } from "../data/site";
---

<div class="movie-shelf" aria-label="Four favorite films">
  {
    movies.map(([title, , slug], i) => (
      <details
        name="favorite-film"
        open={i === 0}
        style={`--case-color:${["#253b59", "#d1bc85", "#3b4b4b", "#773f39"][i]}`}
      >
        <summary aria-label={`Show ${title} cover`}>
          <img class="dvd-spine" src={`/movies/spines/${slug}.webp`} alt="" loading="lazy" />
          <span class="sr-only">{title}</span>
        </summary>
        <a
          class="movie-cover"
          href={`https://letterboxd.com/film/${slug}/`}
          aria-label={`${title} on Letterboxd`}
        >
          <img
            src={`/movies/${slug}.webp`}
            alt={`${title} theatrical poster`}
            width="300"
            height="450"
            loading="lazy"
          />
        </a>
      </details>
    ))
  }
</div>
<p class="muted shelf-hint">Open a spine. Pick a film.</p>
