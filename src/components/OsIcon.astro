---
import AppIcon from "./AppIcon.astro";
interface Props { name: string; device: string; }
const { name, device } = Astro.props;
const dsAssets = ["work", "movies", "music", "settings"];
const image = name === "play" && device !== "gba" ? `/ui/games/${device}.webp` : device === "ipod" && !["messages", "links"].includes(name) ? `/ui/ios/${name === "browser" ? "links" : name}.webp` : device === "3ds" && dsAssets.includes(name) ? `/ui/3ds/${name}.png` : null;
---
{image ? <img src={image} alt="" width="64" height="64" decoding="async" /> : <AppIcon name={name} />}
