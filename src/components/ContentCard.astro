---
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<div class:list={['content-card', className]}>
  {title && <h2 class="card-title">{title}</h2>}
  <div class="card-content">
    <slot />
  </div>
</div>

<style>
  .content-card {
    background: var(--card-bg);
    padding: var(--space-6);
    width: 100%;
    max-width: 800px;
    box-shadow: var(--shadow-card);
  }

  .card-title {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-semibold);
    color: #333;
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--card-border);
  }

  .card-content {
    color: #444;
    line-height: 1.6;
  }

  .card-content :global(p) {
    margin: 0 0 var(--space-4);
  }

  .card-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .card-content :global(a) {
    color: var(--xbox-green);
    text-decoration: underline;
  }

  .card-content :global(a:hover) {
    color: var(--xbox-green-dark);
  }
</style>
