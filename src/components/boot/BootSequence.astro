---
interface Props {
  gamertag?: string;
  avatarSrc?: string;
  skipForReturning?: boolean;
}

const {
  gamertag = 'SwagMan67',
  avatarSrc = '/avatar/avatar-prof.png',
  skipForReturning = true,
} = Astro.props;
---

<div
  id="boot-sequence"
  class="boot-sequence"
  data-skip-returning={skipForReturning}
  data-gamertag={gamertag}
>
  <!-- Profile Selection -->
  <div class="profile-select">
    <!-- Header - top right -->
    <div class="profile-header">
      <h2 class="profile-title">sign in or out</h2>
      <p class="profile-subtitle">Choose your profile</p>
    </div>

    <!-- Profile card - right side -->
    <div class="profile-card-container">
      <span class="signing-status" id="signing-status">SELECT PROFILE</span>
      <button class="profile-card" tabindex="0">
        <div class="profile-avatar">
          <img src={avatarSrc} alt={gamertag} />
        </div>
        <div class="profile-info">
          <span class="profile-name">{gamertag}</span>
        </div>
      </button>
    </div>
  </div>
</div>

<style>
  .boot-sequence {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: linear-gradient(180deg, #505050 0%, #787878 40%, #d8d8d8 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.5s ease-out;
  }

  .boot-sequence.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .boot-sequence.removed {
    display: none;
  }

  /* === PROFILE SELECTION === */
  .profile-select {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
  }

  .profile-header {
    position: absolute;
    top: 80px;
    right: 100px;
    text-align: right;
  }

  .profile-title {
    font-size: 2.5rem;
    font-weight: 300;
    color: #ffffff;
    margin: 0;
    font-family: 'Segoe UI', system-ui, sans-serif;
  }

  .profile-subtitle {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 8px 0 0;
    font-family: 'Segoe UI', system-ui, sans-serif;
  }

  .profile-card-container {
    position: absolute;
    top: 50%;
    right: 100px;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .signing-status {
    font-size: 1rem;
    font-weight: 600;
    color: #9ACD32;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-family: 'Segoe UI', system-ui, sans-serif;
  }

  .signing-status.signing {
    animation: signing-pulse 1s ease-in-out infinite;
  }

  @keyframes signing-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  .profile-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .profile-card:hover,
  .profile-card:focus {
    transform: scale(1.02);
    outline: none;
  }

  .profile-card:focus .profile-avatar {
    box-shadow: 0 0 0 3px #9ACD32;
  }

  .profile-avatar {
    width: 56px;
    height: 56px;
    border-radius: 2px;
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.5);
    transition: box-shadow 0.2s ease;
  }

  .profile-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    text-align: left;
  }

  .profile-name {
    font-size: 1.5rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.85);
    font-family: 'Segoe UI', system-ui, sans-serif;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .profile-header {
      top: 40px;
      right: 24px;
    }

    .profile-title {
      font-size: 1.75rem;
    }

    .profile-subtitle {
      font-size: 1rem;
    }

    .profile-card-container {
      right: 24px;
    }

    .profile-avatar {
      width: 48px;
      height: 48px;
    }

    .profile-name {
      font-size: 1.25rem;
    }
  }
</style>

<script>
  import { audioManager } from '@/lib/audio/AudioManager';

  const bootSequence = document.getElementById('boot-sequence');
  const skipForReturning = bootSequence?.dataset.skipReturning === 'true';

  // Check if returning visitor
  const isReturningVisitor =
    typeof localStorage !== 'undefined' && localStorage.getItem('xbox-visited') === 'true';

  function initBootSequence() {
    if (!bootSequence) return;

    if (skipForReturning && isReturningVisitor) {
      // Skip boot sequence for returning visitors
      bootSequence.classList.add('hidden');
      setTimeout(() => {
        bootSequence.classList.add('removed');
        window.dispatchEvent(new CustomEvent('boot-complete'));
      }, 500);
      return;
    }

    // Initialize audio
    audioManager.init().catch(() => {});
    audioManager.play('navigate');
  }

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBootSequence);
  } else {
    initBootSequence();
  }

  // Click profile to sign in
  const profileCard = document.querySelector('.profile-card');
  const signingStatus = document.getElementById('signing-status');

  profileCard?.addEventListener('click', () => {
    audioManager.play('select');

    // Mark as visited now that user has signed in
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem('xbox-visited', 'true');
    }

    // Show signing in status with animation
    if (signingStatus) {
      signingStatus.textContent = 'SIGNING IN ..';
      signingStatus.classList.add('signing');
    }

    // Play login sound and complete boot after delay
    setTimeout(() => {
      audioManager.play('login');
    }, 300);

    setTimeout(() => {
      bootSequence?.classList.add('hidden');
      setTimeout(() => {
        bootSequence?.classList.add('removed');
        window.dispatchEvent(new CustomEvent('boot-complete'));
      }, 500);
    }, 1500);
  });
</script>
