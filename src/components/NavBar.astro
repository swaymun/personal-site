---
interface Props {
  activeTab?: string;
}

const { activeTab = 'home' } = Astro.props;

const navItems = [
  { id: 'home', label: 'home', href: '/' },
  { id: 'projects', label: 'projects', href: '/projects' },
  { id: 'about', label: 'about', href: '/about' },
  { id: 'contact', label: 'contact', href: '/contact' },
];
---

<header class="nav-bar">
  <nav class="nav-tabs" role="navigation" aria-label="Main navigation">
    <ul class="nav-list">
      {navItems.map((item) => (
        <li class="nav-item">
          <a
            href={item.href}
            class:list={['nav-link', { active: activeTab === item.id }]}
            aria-current={activeTab === item.id ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- User Info Area (optional - can be customized) -->
  <div class="user-info">
    <span class="gamertag">Developer</span>
  </div>
</header>

<style>
  .nav-bar {
    position: fixed;
    top: var(--space-6);
    left: 0;
    right: 0;
    height: var(--nav-height);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--space-8);
    z-index: var(--z-nav);
    background: transparent;
  }

  .nav-tabs {
    display: flex;
    justify-content: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-10);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-light);
    color: var(--text-nav-inactive);
    text-decoration: none;
    padding: var(--space-2) var(--space-4);
    transition: all var(--transition-fast);
    letter-spacing: 0.02em;
    text-transform: lowercase;
  }

  .nav-link:hover {
    color: var(--text-primary);
    transform: scale(1.05);
  }

  .nav-link.active {
    color: var(--text-nav-active);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-3xl);
  }

  .user-info {
    display: none;
  }

  .gamertag {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  /* Focus state for keyboard navigation */
  .nav-link:focus-visible {
    outline: 2px solid var(--xbox-green);
    outline-offset: 4px;
    border-radius: var(--border-radius-sm);
  }
</style>
