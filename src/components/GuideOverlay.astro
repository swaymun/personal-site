---
// Xbox Guide Button Overlay - Sound Control + Achievements
import { achievements, getTotalPossibleGamerscore } from '@/lib/achievements/achievements';

const totalPossible = getTotalPossibleGamerscore();
---

<div
  id="guide-overlay"
  class="guide-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="guide-title"
>
  <div class="guide-backdrop"></div>
  <div class="guide-panel">
    <!-- Sound Section -->
    <div class="guide-section">
      <h2 id="guide-title" class="guide-header">Sound</h2>
      <div class="volume-control">
        <button class="volume-btn" id="guide-mute" aria-label="Toggle sound">
          <svg class="mute-icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
          </svg>
          <svg class="mute-icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <line x1="23" y1="9" x2="17" y2="15"></line>
            <line x1="17" y1="9" x2="23" y2="15"></line>
          </svg>
        </button>
        <span class="volume-label" id="volume-label">Sound On</span>
      </div>
    </div>

    <!-- Achievements Section -->
    <div class="guide-section achievements-section">
      <h2 class="guide-header">Achievements</h2>
      <div class="achievements-score">
        <span id="guide-gamerscore">0</span>G / <span>{totalPossible}</span>G
      </div>
      <ul class="achievements-list" id="achievements-list">
        {achievements.map((achievement) => (
          <li class="achievement-item" data-achievement-id={achievement.id}>
            <div class="achievement-icon">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
              </svg>
            </div>
            <div class="achievement-info">
              <span class="achievement-title">{achievement.title}</span>
              <span class="achievement-desc">{achievement.description}</span>
            </div>
            <span class="achievement-score">{achievement.gamerscore}G</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<style>
  .guide-overlay {
    position: fixed;
    inset: 0;
    z-index: 350;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s ease,
      visibility 0.25s ease;
  }

  .guide-overlay.open {
    opacity: 1;
    visibility: visible;
  }

  .guide-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(6px);
  }

  .guide-panel {
    position: relative;
    background: linear-gradient(180deg, #2a2a2a 0%, #1a1a1a 100%);
    border: 2px solid #107c10;
    border-radius: 8px;
    padding: 24px 32px;
    min-width: 360px;
    max-width: 90vw;
    max-height: 80vh;
    overflow-y: auto;
    transform: scale(0.9);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.5),
      0 0 30px rgba(16, 124, 16, 0.2);
  }

  .guide-overlay.open .guide-panel {
    transform: scale(1);
  }

  .guide-header {
    font-size: 1.25rem;
    font-weight: 300;
    color: #ffffff;
    text-align: center;
    margin: 0 0 20px;
    font-family: 'Segoe UI', system-ui, sans-serif;
  }

  .volume-control {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .volume-btn {
    background: rgba(16, 124, 16, 0.3);
    border: none;
    color: #ffffff;
    cursor: pointer;
    padding: 16px;
    border-radius: 50%;
    transition:
      background 0.15s ease,
      transform 0.15s ease;
  }

  .volume-btn:hover {
    background: rgba(16, 124, 16, 0.5);
    transform: scale(1.05);
  }

  .volume-btn:active {
    transform: scale(0.95);
  }

  .volume-btn svg {
    width: 32px;
    height: 32px;
  }

  /* Sound ON state (not muted) - show volume icon, hide mute icon */
  .volume-btn .mute-icon-on {
    display: block;
  }
  .volume-btn .mute-icon-off {
    display: none;
  }

  /* Sound OFF state (muted) - hide volume icon, show mute icon */
  .volume-btn.muted .mute-icon-on {
    display: none;
  }
  .volume-btn.muted .mute-icon-off {
    display: block;
  }

  .volume-label {
    font-size: 14px;
    color: #888;
    font-family: 'Segoe UI', system-ui, sans-serif;
  }

  /* Guide sections */
  .guide-section {
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 20px;
  }

  .guide-section:last-child {
    border-bottom: none;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  /* Achievements */
  .achievements-section .guide-header {
    margin-bottom: 8px;
  }

  .achievements-score {
    text-align: center;
    font-size: 14px;
    color: #9bc83b;
    margin-bottom: 16px;
    font-family: 'Segoe UI', system-ui, sans-serif;
  }

  .achievements-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .achievement-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    opacity: 0.4;
    transition: opacity 0.2s ease, background 0.2s ease;
  }

  .achievement-item.unlocked {
    opacity: 1;
    background: rgba(16, 124, 16, 0.2);
  }

  .achievement-icon {
    width: 28px;
    height: 28px;
    color: #666;
    flex-shrink: 0;
  }

  .achievement-item.unlocked .achievement-icon {
    color: #9bc83b;
  }

  .achievement-icon svg {
    width: 100%;
    height: 100%;
  }

  .achievement-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .achievement-title {
    font-size: 14px;
    font-weight: 500;
    color: #fff;
    font-family: 'Segoe UI', system-ui, sans-serif;
  }

  .achievement-desc {
    font-size: 11px;
    color: #888;
    font-family: 'Segoe UI', system-ui, sans-serif;
  }

  .achievement-score {
    font-size: 13px;
    color: #9bc83b;
    font-weight: 500;
    flex-shrink: 0;
    font-family: 'Segoe UI', system-ui, sans-serif;
  }

  .achievement-item:not(.unlocked) .achievement-score {
    color: #666;
  }
</style>

<script>
  import { audioManager } from '@/lib/audio/AudioManager';
  import { achievementManager } from '@/lib/achievements/AchievementManager';

  const overlay = document.getElementById('guide-overlay');
  const muteBtn = document.getElementById('guide-mute');
  const volumeLabel = document.getElementById('volume-label');
  const gamerscoreEl = document.getElementById('guide-gamerscore');
  const achievementsList = document.getElementById('achievements-list');

  function updateLabel() {
    if (volumeLabel) {
      volumeLabel.textContent = audioManager.getMuted() ? 'Sound Off' : 'Sound On';
    }
  }

  function updateAchievements() {
    // Update gamerscore
    if (gamerscoreEl) {
      gamerscoreEl.textContent = String(achievementManager.getTotalGamerscore());
    }

    // Update unlocked states
    if (achievementsList) {
      const items = achievementsList.querySelectorAll('.achievement-item');
      items.forEach((item) => {
        const id = item.getAttribute('data-achievement-id');
        if (id && achievementManager.isUnlocked(id)) {
          item.classList.add('unlocked');
        } else {
          item.classList.remove('unlocked');
        }
      });
    }
  }

  function closeGuide() {
    overlay?.classList.remove('open');
    audioManager.play('guide-close');
  }

  // Update mute button state when guide opens
  overlay?.addEventListener('transitionend', () => {
    if (overlay.classList.contains('open')) {
      muteBtn?.classList.toggle('muted', audioManager.getMuted());
      updateLabel();
      updateAchievements();
    }
  });

  // Global keyboard shortcut (G key or Escape to close)
  document.addEventListener('keydown', (e) => {
    // Don't trigger if typing in an input
    if ((e.target as HTMLElement).tagName === 'INPUT') return;

    // Ignore if modal or boot is open
    const modal = document.getElementById('announcements-modal');
    const boot = document.getElementById('boot-sequence');
    if (modal?.classList.contains('open')) return;
    if (boot && !boot.classList.contains('removed')) return;

    if (e.key === 'g' || e.key === 'G') {
      if (overlay?.classList.contains('open')) {
        closeGuide();
      } else {
        overlay?.classList.add('open');
        audioManager.play('guide-open');
        muteBtn?.classList.toggle('muted', audioManager.getMuted());
        updateLabel();
        updateAchievements();
      }
    }

    if (e.key === 'Escape' && overlay?.classList.contains('open')) {
      closeGuide();
    }
  });

  // Click backdrop to close
  overlay?.querySelector('.guide-backdrop')?.addEventListener('click', closeGuide);

  // Mute toggle
  muteBtn?.addEventListener('click', () => {
    const isMuted = audioManager.toggleMute();
    muteBtn.classList.toggle('muted', isMuted);
    updateLabel();
    audioManager.play('select');
  });

  // Listen for new achievements while guide is open
  window.addEventListener('achievement-unlocked', () => {
    if (overlay?.classList.contains('open')) {
      updateAchievements();
    }
  });
</script>
