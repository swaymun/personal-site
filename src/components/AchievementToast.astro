---
// Achievement Toast Notification Component
// This component displays Xbox 360-style achievement unlocked notifications
---

<div
  id="achievement-toast"
  class="achievement-toast"
  role="alert"
  aria-live="polite"
  aria-atomic="true"
>
  <div class="toast-icon">
    <svg viewBox="0 0 24 24" fill="currentColor">
      <path
        d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"
      ></path>
    </svg>
  </div>
  <div class="toast-content">
    <div class="toast-header">
      <span class="achievement-label">Achievement Unlocked</span>
      <span class="gamerscore">+<span id="toast-score">0</span>G</span>
    </div>
    <div class="toast-title" id="toast-title">Achievement Name</div>
    <div class="toast-description" id="toast-description">Description</div>
  </div>
</div>

<style>
  .achievement-toast {
    position: fixed;
    bottom: 80px;
    right: 20px;
    background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
    border: 2px solid #107c10;
    border-radius: 4px;
    padding: 16px 20px;
    display: flex;
    gap: 16px;
    align-items: center;
    min-width: 320px;
    max-width: 420px;
    transform: translateX(calc(100% + 40px));
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    z-index: 250;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.5),
      0 0 20px rgba(16, 124, 16, 0.3);
  }

  .achievement-toast.show {
    transform: translateX(0);
    opacity: 1;
  }

  .toast-icon {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, #107c10 0%, #0e6a0e 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(16, 124, 16, 0.4);
  }

  .toast-icon svg {
    width: 24px;
    height: 24px;
    color: #ffffff;
  }

  .toast-content {
    flex: 1;
    color: #ffffff;
    min-width: 0;
  }

  .toast-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }

  .achievement-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #107c10;
    font-weight: 600;
    font-family: 'Segoe UI', system-ui, sans-serif;
  }

  .gamerscore {
    font-size: 14px;
    font-weight: 600;
    color: #7cb342;
    font-family: 'Segoe UI', system-ui, sans-serif;
  }

  .toast-title {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 4px;
    font-family: 'Segoe UI', system-ui, sans-serif;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .toast-description {
    font-size: 13px;
    color: #b3b3b3;
    font-family: 'Segoe UI', system-ui, sans-serif;
    line-height: 1.3;
  }

  @media (max-width: 480px) {
    .achievement-toast {
      left: 16px;
      right: 16px;
      bottom: 70px;
      min-width: auto;
      max-width: none;
    }
  }
</style>

<script>
  const toast = document.getElementById('achievement-toast');
  const titleEl = document.getElementById('toast-title');
  const descEl = document.getElementById('toast-description');
  const scoreEl = document.getElementById('toast-score');

  let hideTimeout: ReturnType<typeof setTimeout>;
  const toastQueue: Array<{ title: string; description: string; gamerscore: number }> = [];
  let isShowingToast = false;

  function showToast(achievement: { title: string; description: string; gamerscore: number }) {
    if (!toast || !titleEl || !descEl || !scoreEl) return;

    titleEl.textContent = achievement.title;
    descEl.textContent = achievement.description;
    scoreEl.textContent = String(achievement.gamerscore);

    toast.classList.add('show');

    clearTimeout(hideTimeout);
    hideTimeout = setTimeout(() => {
      toast.classList.remove('show');
      isShowingToast = false;

      // Show next toast in queue after animation
      setTimeout(() => {
        if (toastQueue.length > 0) {
          const next = toastQueue.shift();
          if (next) showToast(next);
        }
      }, 400);
    }, 5000);

    isShowingToast = true;
  }

  // Listen for achievement unlocked events
  window.addEventListener('achievement-unlocked', ((e: CustomEvent) => {
    const achievement = e.detail;

    if (isShowingToast) {
      // Queue the toast
      toastQueue.push(achievement);
    } else {
      showToast(achievement);
    }
  }) as EventListener);
</script>
