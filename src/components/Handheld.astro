---
import { apps, titles, sections } from "../data/site";
import type { devices } from "../data/site";
import Hardware from "./Hardware.astro";
import Content from "./Content.astro";
import AppIcon from "./AppIcon.astro";
import OsIcon from "./OsIcon.astro";
interface Props {
  device: (typeof devices)[number];
}
const { device: d } = Astro.props;
type Control = {
  key: string;
  label: string;
  x: number;
  y: number;
  w: number;
  h: number;
  kind?: string;
};
const controls: Control[] = [];
function button(
  key: string,
  label: string,
  x: number,
  y: number,
  w = 30,
  h = w,
  kind = "round",
) {
  controls.push({ key, label, x, y, w, h, kind });
}
function dpad(x: number, y: number, size: number) {
  button("up", "↑", x, y - size, size, size, "dpad");
  button("down", "↓", x, y + size, size, size, "dpad");
  button("left", "←", x - size, y, size, size, "dpad");
  button("right", "→", x + size, y, size, size, "dpad");
}
function face(x: number, y: number, size: number, gap: number, psp = false) {
  button("action", psp ? "×" : "A", psp ? x : x + gap, psp ? y + gap : y, size);
  button("back", psp ? "○" : "B", psp ? x + gap : x, psp ? y : y + gap, size);
  button("secondary", psp ? "□" : "Y", x - gap, y, size);
  button("extra", psp ? "△" : "X", x, y - gap, size);
}
if (d.id === "gba") {
  dpad(66, 305, 18);
  button("action", "A", 202, 299, 28);
  button("back", "B", 164, 309, 28);
  button("start", "START", 148, 408, 29);
  button("select", "SELECT", 105, 408, 29);
  button("home", "Menu", 125, 256, 18);
  button("l", "L", 35, 218, 43, 19, "shoulder");
  button("r", "R", 220, 218, 43, 19, "shoulder");
}
if (d.id === "psp") {
  dpad(112, 184, 51);
  face(894, 184, 53, 59, true);
  button("home", "PS", 218, 393, 60, 28, "pill");
  button("select", "SELECT", 714, 393, 56, 28, "pill");
  button("start", "START", 779, 393, 57, 28, "pill");
  button("l", "L", 125, 18, 100, 27, "shoulder");
  button("r", "R", 879, 18, 100, 27, "shoulder");
  button("sound", "Sound", 650, 393, 42, 28, "pill");
}
if (d.id === "ipod") {
  button("home", "Home", 280, 970, 92);
  button("power", "Power", 110, 6, 70, 12, "power");
}
if (d.id === "3ds") {
  dpad(76, 497, 27);
  face(501, 402, 35, 33);
  button("home", "Home", 290, 563, 65, 25, "pill");
  button("select", "SELECT", 198, 563, 65, 25, "pill");
  button("start", "START", 380, 563, 65, 25, "pill");
  button("power", "Power", 463, 549, 28);
  button("l", "L", 39, 303, 60, 23, "shoulder");
  button("r", "R", 543, 303, 60, 23, "shoulder");
}
if (d.id === "switch") {
  dpad(74, 228, 32);
  face(927, 110, 33, 32);
  button("home", "Home", 903, 306, 36);
  button("select", "−", 115, 45, 30, 22);
  button("start", "+", 885, 44, 32);
  button("l", "L", 72, 9, 70, 18, "shoulder");
  button("r", "R", 928, 9, 70, 18, "shoulder");
}
const style = (x: number, y: number, w: number, h: number) =>
  `left:${((x - w / 2) / d.width) * 100}%;top:${((y - h / 2) / d.height) * 100}%;width:${(w / d.width) * 100}%;height:${(h / d.height) * 100}%`;
const [sx, sy, sw, sh] = d.screen;
---

<div class={`handheld-page ${d.id}`} data-device={d.id} data-game={d.game}>
  <h1 class="sr-only">{d.name}</h1>
  <div class="device-stage">
    <div
      class="device"
      style={`--ratio:${d.width}/${d.height};--device-width:${d.width}px`}
    >
      <Hardware device={d} />
      {
        d.id === "3ds" && (
          <div class="upper-screen">
            <>
              <div class="upper-time">
                Nintendo 3DS <span class="clock">12:00</span>
              </div>
              <div class="upper-icon"><OsIcon name="home" device={d.id} /></div>
              <strong id="upper-title">Home</strong>
              <span>Saimun Shahee</span>
            </>
          </div>
        )
      }
      {
        controls.map((c) => (
          <button
            class={`hardware-button ${c.kind}`}
            style={style(c.x, c.y, c.w, c.h)}
            data-input={c.key}
            aria-label={`${c.label} — ${c.key === "back" ? "back / dodge" : c.key === "action" ? "confirm / action" : c.key}`}
            title={c.key}
          >
            {c.label}
          </button>
        ))
      }
      {
        ["psp", "3ds", "switch"].includes(d.id) && (
          <div
            class="analog-stick"
            data-analog
            role="group"
            aria-label="Analog stick. Drag to move; arrow keys also work."
            style={style(
              d.id === "psp" ? 115 : d.id === "3ds" ? 76 : 74,
              d.id === "psp" ? 318 : d.id === "3ds" ? 392 : 110,
              d.id === "3ds" ? 86 : 72,
              d.id === "3ds" ? 86 : 72,
            )}
          >
            <span />
          </div>
        )
      }
      <div class="lower-game-help">
        <strong>Pocket Ruins</strong><span
          >A / Z: sword<br />D-pad: move<br />Start: pause</span>
      </div>
      <div
        class="screen"
        style={`--screen-left:${(sx / d.width) * 100}%;--screen-top:${(sy / d.height) * 100}%;--screen-width:${(sw / d.width) * 100}%;--screen-height:${(sh / d.height) * 100}%`}
        tabindex="0"
        aria-label={`${d.label} interactive screen`}
      >
        <div class="screen-status">
          <span
            >{
              d.id === "ipod"
                ? "iPod"
                : d.id === "gba"
                  ? "SAIMUN"
                  : d.id === "switch"
                    ? "Saimun"
                    : "HOME"
            }</span
          ><span class="clock">12:00</span><span class="battery" aria-label="Battery full"></span>
        </div>
        <div class="launcher" id="launcher">
          {d.id === "3ds" && <div class="ds-utilities">{(["notes", "links", "settings"] as const).map(app => <button data-open={app} aria-label={`Open ${titles[app]} utility`}><AppIcon name={app} /></button>)}</div>}
          <div class="launcher-heading" aria-live="polite">
            {
              d.id === "gba"
                ? "SELECT A CARTRIDGE"
                : d.id === "ipod"
                  ? ""
                  : d.id === "psp"
                    ? ""
                    : "Home"
            }
          </div><div class="app-grid">
            {
              apps.map((app, i) => (
                <button
                  class={`app-button app-${app}`}
                  data-app={app}
                  data-index={i}
                  aria-label={`Open ${titles[app]}`}
                >
                  <>
                    <span class={`app-icon icon-${app}`}>
                      <OsIcon name={app} device={d.id} />
                    </span>
                    <span>{titles[app]}</span>
                  </>
                </button>
              ))
            }
          </div>{
            d.id === "psp" && (
              <div class="xmb-items" aria-label="Category items" />
            )
          }{
            d.id === "ipod" && (
              <div class="ios-page-dots" aria-hidden="true"><i></i><i></i></div><div class="ipod-dock">
                {(["home", "music", "links", "settings"] as const).map(
                  (app) => (
                    <button data-open={app}>
                      <span class={`app-icon icon-${app}`}>
                        <OsIcon name={app} device={d.id} />
                      </span>
                      {titles[app]}
                    </button>
                  ),
                )}
              </div>
            )
          }{
            d.id === "switch" && (
              <div class="switch-utilities">
                {(["notes", "links", "settings"] as const).map((app) => (
                  <button
                    data-open={app}
                    aria-label={`Open ${titles[app]} utility`}
                  >
                    <OsIcon name={app} device={d.id} />
                  </button>
                ))}
              </div>
            )
          }<div class="launcher-footer">
            {
              d.id === "gba"
                ? "D-PAD: SELECT    A: OPEN"
                : d.id === "psp"
                  ? "← → Category     × Enter"
                  : d.id === "ipod"
                    ? "Slide into something good."
                    : d.id === "switch" ? "A Start" : "Open"
            }
          </div>
        </div>
        <div id="app-view" hidden>
          <header class="app-toolbar">
            <button id="back-menu" aria-label="Back to device menu"
              >‹ Menu</button
            ><strong id="app-title">Home</strong>
          </header><div id="app-body" tabindex="0"></div><footer
            class="app-pager"
          >
            <button id="page-prev" aria-label="Previous content page">‹</button
            ><span id="page-position">Scroll to read</span><button
              id="page-next"
              aria-label="Next content page">›</button>
          </footer>
        </div>
        <div id="game-view" hidden>
          <canvas
            id="game-canvas"
            width="480"
            height="320"
            aria-label={`${d.game} game`}
            role="img"></canvas><div id="game-overlay">
            <strong id="game-heading">{d.game}</strong><p id="game-message">
              {d.genre}
            </p><button id="game-resume">Play</button><button
              id="game-restart"
              hidden>Restart</button
            ><button id="game-exit">Exit game</button>
          </div><div id="game-live" class="sr-only" aria-live="polite">
          </div><button id="game-pause" aria-label="Pause game">Ⅱ</button>
        </div>
        <div id="boot" hidden>
          <strong
            >{
              d.id === "gba"
                ? "GAME BOY"
                : d.id === "psp"
                  ? "PSP"
                  : d.id === "ipod"
                    ? "iPod"
                    : d.id === "3ds"
                      ? "Nintendo 3DS"
                      : "Nintendo Switch"
            }</strong
          ><span>Saimun's handheld</span><button id="skip-boot"
            >Skip startup</button>
        </div>
      </div>
    </div>
  </div>
  <div class="device-caption">
    <span>{d.name}</span><span class="muted">{d.color}</span>
  </div>
  <div class="device-tools">
    <button id="expand">Expand screen</button><a id="text-link" href="/"
      >Read as text</a
    ><button id="sound-toggle" aria-pressed="false">Sound off</button><button
      id="power">Restart device</button>
  </div>
  <div class="expanded-controls" aria-label="Touch game controls">
    <div class="touch-dpad">
      <button data-input="up" aria-label="Move up">↑</button><button
        data-input="left"
        aria-label="Move left">←</button
      ><button data-input="down" aria-label="Move down">↓</button><button
        data-input="right"
        aria-label="Move right">→</button>
    </div><div>
      <button data-input="action">{d.id === "psp" ? "×" : "A"}</button><button
        data-input="back">{d.id === "psp" ? "○" : "B"}</button
      ><button data-input="start">Pause</button><button data-input="home"
        >Menu</button>
    </div>
  </div>
  <p class="control-hint">
    {
      d.id === "ipod"
        ? "Tap an app. The Home button takes you back."
        : "Click the buttons, or use arrow keys · Z / Enter to select · X / Esc to go back."
    }
  </p>
  <details class="controls-help">
    <summary>Controls &amp; about this handheld</summary><p>
      {d.instructions}
    </p><p>
      Shoulder buttons switch apps or scroll a page. Start pauses a game. Home
      returns to the menu. Drag the analog stick or use arrow keys to move.
      Expand the screen for larger touch controls.
    </p><p>
      This is a small browser tribute, not an emulator. Personal content is
      identical in every handheld. Your notes and game records stay on this
      browser.
    </p><p><a href="/credits/">Hardware and interface credits</a></p>
  </details>
  <noscript
    ><p class="text-page">
      This handheld needs JavaScript. <a href="/"
        >Read the ordinary text site instead.</a>
    </p></noscript
  >
  {
    sections.map((section) => (
      <template id={`content-${section}`}>
        <Content section={section} compact />
        {section === "games" && (
          <div class="game-entry">
            <h2>{d.game}</h2>
            <p>{d.genre}</p>
            <p>{d.instructions}</p>
            <p class="best-record" />
            <button data-launch-game>Play {d.game}</button>
          </div>
        )}
      </template>
    ))
  }
  <template id="content-notes"
    ><div class="notes-app">
      <label for="notes-text">A note to yourself</label><textarea
        id="notes-text"
        placeholder="Write something here…"
        spellcheck="true"></textarea><p id="notes-status" role="status">
        Saved only in this browser.
      </p>
    </div></template
  >
  <template id="content-settings"
    ><div class="settings-app">
      <h2>Settings</h2><label
        ><input id="settings-sound" type="checkbox" /> Enable sound</label
      ><p>Boot and menu sounds play only after you enable them.</p><button
        id="reset-scores">Reset game records</button
      ><p id="settings-status" role="status"></p><h2>Controls</h2><p>
        Arrows / WASD: move<br />Z / Enter / Space: action<br />X / Escape: back
        or dodge<br />P / Start: pause<br />Q / E: shoulders<br />H: device menu
      </p><p>Notes and scores are local. No account, no uploads.</p><a
        href="/audio/sources.json">Audio source notes</a>
    </div></template
  >
</div>
<script>
  import "../lib/handheld";
</script>
