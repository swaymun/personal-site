---
import { ViewTransitions } from 'astro:transitions';
import '@/styles/global.css';
import NavBar from '@/components/NavBar.astro';
import ActionHints from '@/components/ActionHints.astro';

interface Props {
  title: string;
  activeTab?: string;
}

const { title, activeTab = 'home' } = Astro.props;

// Page order for swipe navigation
const pageOrder = ['home', 'projects', 'about', 'contact'];
const currentIndex = pageOrder.indexOf(activeTab);
const prevPage = currentIndex > 0 ? pageOrder[currentIndex - 1] : null;
const nextPage = currentIndex < pageOrder.length - 1 ? pageOrder[currentIndex + 1] : null;

const pageUrls: Record<string, string> = {
  home: '/',
  projects: '/projects',
  about: '/about',
  contact: '/contact',
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Saimun - Software Engineer Portfolio" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body data-page={activeTab}>
    <div class="xbox-dashboard">
      <!-- Top Navigation -->
      <NavBar activeTab={activeTab} />

      <!-- Main Content Area with swipe container -->
      <main class="dashboard-content" transition:animate="slide">
        <!-- Left peek indicator -->
        {prevPage && (
          <a href={pageUrls[prevPage]} class="page-peek page-peek--left" aria-label={`Go to ${prevPage}`}>
            <div class="peek-arrow">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </div>
            <span class="peek-label">{prevPage}</span>
          </a>
        )}

        <!-- Page content -->
        <div class="page-content">
          <slot />
        </div>

        <!-- Right peek indicator -->
        {nextPage && (
          <a href={pageUrls[nextPage]} class="page-peek page-peek--right" aria-label={`Go to ${nextPage}`}>
            <span class="peek-label">{nextPage}</span>
            <div class="peek-arrow">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </div>
          </a>
        )}
      </main>

      <!-- Bottom Action Hints with navigation -->
      <ActionHints
        showSelect={true}
        showBack={!!prevPage}
        customHints={[
          { button: 'A', label: 'Select' },
          ...(prevPage ? [{ button: 'B' as const, label: 'Back' }] : []),
        ]}
      />

      <!-- Page indicators -->
      <div class="page-indicators">
        {pageOrder.map((page, i) => (
          <a
            href={pageUrls[page]}
            class:list={['indicator', { active: page === activeTab }]}
            aria-label={`Go to ${page}`}
            aria-current={page === activeTab ? 'page' : undefined}
          />
        ))}
      </div>
    </div>

    <!-- Keyboard and swipe navigation script -->
    <script define:vars={{ prevPage, nextPage, pageUrls }}>
      const pageContent = document.querySelector('.page-content');
      const leftPeek = document.querySelector('.page-peek--left');
      const rightPeek = document.querySelector('.page-peek--right');

      // Navigate with View Transitions for smooth animation
      function navigateTo(url, direction = 'right') {
        document.body.dataset.swipeDirection = direction;
        if (document.startViewTransition) {
          document.startViewTransition(() => {
            window.location.href = url;
          });
        } else {
          window.location.href = url;
        }
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft' && prevPage) {
          navigateTo(pageUrls[prevPage], 'left');
        } else if (e.key === 'ArrowRight' && nextPage) {
          navigateTo(pageUrls[nextPage], 'right');
        }
      });

      // Trackpad/touch swipe with live visual feedback
      let isDragging = false;
      let startX = 0;
      let currentX = 0;
      let dragOffset = 0;

      function updateDragVisual(offset) {
        // Limit drag distance with rubber band effect
        const maxDrag = 200;
        const limitedOffset = Math.sign(offset) * Math.min(Math.abs(offset), maxDrag) * 0.6;

        if (pageContent) {
          pageContent.style.transform = `translateX(${limitedOffset}px)`;
          pageContent.style.transition = 'none';
        }

        // Show peek indicators based on drag direction
        if (leftPeek && offset > 20) {
          leftPeek.style.opacity = Math.min(offset / 100, 1);
          leftPeek.style.transform = `translateY(-50%) translateX(${Math.min(offset * 0.3, 30)}px)`;
        }
        if (rightPeek && offset < -20) {
          rightPeek.style.opacity = Math.min(Math.abs(offset) / 100, 1);
          rightPeek.style.transform = `translateY(-50%) translateX(${Math.max(offset * 0.3, -30)}px)`;
        }
      }

      function resetDragVisual() {
        if (pageContent) {
          pageContent.style.transform = '';
          pageContent.style.transition = 'transform 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
        }
        if (leftPeek) {
          leftPeek.style.opacity = '';
          leftPeek.style.transform = '';
        }
        if (rightPeek) {
          rightPeek.style.opacity = '';
          rightPeek.style.transform = '';
        }
      }

      // Touch events for mobile
      document.addEventListener('touchstart', (e) => {
        isDragging = true;
        startX = e.touches[0].clientX;
        currentX = startX;
      }, { passive: true });

      document.addEventListener('touchmove', (e) => {
        if (!isDragging) return;
        currentX = e.touches[0].clientX;
        dragOffset = currentX - startX;

        // Only apply visual if horizontal movement is dominant
        if (Math.abs(dragOffset) > 10) {
          updateDragVisual(dragOffset);
        }
      }, { passive: true });

      document.addEventListener('touchend', () => {
        if (!isDragging) return;
        isDragging = false;

        const threshold = 80;
        if (dragOffset > threshold && prevPage) {
          navigateTo(pageUrls[prevPage], 'left');
        } else if (dragOffset < -threshold && nextPage) {
          navigateTo(pageUrls[nextPage], 'right');
        } else {
          resetDragVisual();
        }
        dragOffset = 0;
      });

      // Trackpad two-finger horizontal scroll with live feedback
      let wheelDragOffset = 0;
      let wheelResetTimeout = null;
      let isWheelDragging = false;

      document.addEventListener('wheel', (e) => {
        // Only handle horizontal scrolling
        if (Math.abs(e.deltaX) > Math.abs(e.deltaY) && Math.abs(e.deltaX) > 2) {
          isWheelDragging = true;
          wheelDragOffset -= e.deltaX * 0.5; // Invert for natural scrolling

          updateDragVisual(wheelDragOffset);

          clearTimeout(wheelResetTimeout);
          wheelResetTimeout = setTimeout(() => {
            isWheelDragging = false;
            const threshold = 60;

            if (wheelDragOffset > threshold && prevPage) {
              navigateTo(pageUrls[prevPage], 'left');
            } else if (wheelDragOffset < -threshold && nextPage) {
              navigateTo(pageUrls[nextPage], 'right');
            } else {
              resetDragVisual();
            }
            wheelDragOffset = 0;
          }, 150);
        }
      }, { passive: true });
    </script>
  </body>
</html>

<style>
  .xbox-dashboard {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    position: relative;
    overflow: hidden;
  }

  .dashboard-content {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-8) 0;
    padding-top: calc(var(--nav-height) + var(--space-12));
    padding-bottom: calc(var(--space-12) + var(--space-6));
    position: relative;
  }

  .page-content {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    padding: 0 var(--space-6);
    will-change: transform;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Page peek indicators (left/right arrows to adjacent pages) */
  .page-peek {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-6);
    color: var(--text-secondary);
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 50;
    opacity: 0.4;
  }

  .page-peek--left {
    left: 0;
    padding-left: var(--space-4);
  }

  .page-peek--right {
    right: 0;
    padding-right: var(--space-4);
  }

  .page-peek:hover {
    color: var(--text-primary);
    opacity: 1;
  }

  .page-peek:hover .peek-arrow {
    transform: scale(1.3);
  }

  .page-peek--left:hover {
    transform: translateY(-50%) translateX(-8px);
  }

  .page-peek--right:hover {
    transform: translateY(-50%) translateX(8px);
  }

  .peek-arrow {
    width: 40px;
    height: 40px;
    transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .peek-label {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-light);
    text-transform: lowercase;
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .page-peek:hover .peek-label {
    opacity: 1;
  }

  /* Page indicators (dots at bottom) */
  .page-indicators {
    position: fixed;
    bottom: var(--space-4);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: var(--space-3);
    z-index: var(--z-nav);
  }

  .indicator {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    border: none;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .indicator:hover {
    background: rgba(255, 255, 255, 0.6);
    transform: scale(1.2);
  }

  .indicator.active {
    background: var(--xbox-green);
    transform: scale(1.3);
  }

  /* View Transition animations - smooth cubic-bezier for game-like feel */
  @keyframes slideInFromRight {
    from {
      opacity: 0;
      transform: translateX(60px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes slideInFromLeft {
    from {
      opacity: 0;
      transform: translateX(-60px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes slideOutToLeft {
    from {
      opacity: 1;
      transform: translateX(0);
    }
    to {
      opacity: 0;
      transform: translateX(-60px);
    }
  }

  @keyframes slideOutToRight {
    from {
      opacity: 1;
      transform: translateX(0);
    }
    to {
      opacity: 0;
      transform: translateX(60px);
    }
  }

  /* Custom view transition styles - smoother easing */
  ::view-transition-old(root) {
    animation: slideOutToLeft 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  ::view-transition-new(root) {
    animation: slideInFromRight 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .page-peek {
      display: none;
    }
  }
</style>

<style is:global>
  /* View transition customization - fast and seamless carousel effect */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.25s;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Ensure smooth cross-fade between pages */
  ::view-transition-group(root) {
    animation-duration: 0.25s;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Keep both old and new visible during transition for carousel effect */
  ::view-transition-old(root) {
    animation: carouselSlideOut 0.25s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  ::view-transition-new(root) {
    animation: carouselSlideIn 0.25s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes carouselSlideOut {
    from {
      opacity: 1;
      transform: translateX(0);
    }
    to {
      opacity: 0.3;
      transform: translateX(-100px);
    }
  }

  @keyframes carouselSlideIn {
    from {
      opacity: 0.3;
      transform: translateX(100px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Game UI sound effect placeholder - can add actual sounds */
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none;
    }
  }
</style>
