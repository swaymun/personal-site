---
import '@/styles/global.css';
import BootSequence from '@/components/boot/BootSequence.astro';
import StatusBar from '@/components/gamertag/StatusBar.astro';
import AnnouncementTile from '@/components/announcements/AnnouncementTile.astro';
import AnnouncementsModal from '@/components/announcements/AnnouncementsModal.astro';
import AchievementToast from '@/components/AchievementToast.astro';
import GuideOverlay from '@/components/GuideOverlay.astro';
import Avatar3D from '@/components/avatar/Avatar3D.astro';
import { getCollection } from 'astro:content';

// Get announcements for unread count
const announcements = await getCollection('announcements', ({ data }) => !data.draft);
const latestAnnouncement = announcements.sort((a, b) =>
  b.data.date.getTime() - a.data.date.getTime()
)[0];

// ===== HOME DATA =====
const profile = {
  name: 'Saimun Shahee',
  title: 'Software Engineer @ Meta',
};

// ===== PROJECTS DATA =====
const projects = [
  {
    id: 'project-1',
    title: 'System Design Excalidraws',
    description: 'Collection of diagrams and notes for System Design interviews, covering Netflix, WhatsApp, Google Maps, and more.',
    tags: [],
    link: 'https://github.com/swaymun/system-design-excalidraws',
    color: '#6965DB',
  },
];

// ===== ABOUT DATA =====
const aboutProfile = {
  name: 'Saimun Shahee',
  title: 'Software Engineer',
  location: 'New York, NY',
  education: {
    school: 'Penn State University',
    degree: 'BS Computer Science + Statistics',
    period: '2016 - 2020',
  },
  skills: [
    { category: 'Languages', items: ['Java', 'Kotlin', 'Python', 'TypeScript', 'C++'] },
    { category: 'Frontend', items: ['React.js', 'React Native'] },
    { category: 'Backend', items: ['AWS', 'Distributed Systems'] },
  ],
  experience: [
    { role: 'Software Engineer', company: 'Meta', period: 'Jun 2024 - Present', project: 'AI Glasses', skills: ['Java', 'Kotlin'], logo: 'meta' },
    { role: 'Software Engineer', company: 'Block', period: 'Jan 2022 - Mar 2024', project: 'CashApp Account Security', skills: ['Java', 'Kotlin'], logo: 'block' },
    { role: 'Software Development Engineer', company: 'Amazon', period: 'Jul 2020 - Dec 2021', project: 'AWS Service Catalog / FireTV', skills: ['Java', 'React.js'], logo: 'amazon' },
    { role: 'Software Engineering Intern', company: 'PNC', period: 'May 2019 - Aug 2019', project: 'DevOps Team', skills: ['Python', 'React.js'], logo: 'pnc' },
    { role: 'Software Engineering Intern', company: 'John Deere', period: 'May 2018 - Aug 2018', project: 'Seeding Group', skills: ['C++', 'C'], logo: 'deere' },
  ],
};

const logoColors: Record<string, string> = {
  meta: '#0668E1', block: '#00D632', amazon: '#FF9900', pnc: '#FF6B00', deere: '#367C2B',
};

const logoImages: Record<string, string> = {
  meta: '/logos/meta_transparent.png', block: '/logos/block_transparent.png', amazon: '/logos/amazon_transparent.png',
  pnc: '/logos/pnc_transparent.png', deere: '/logos/john_deere_transparent.png',
};

// ===== CONTACT DATA =====
const contactLinks = [
  { id: 'email', label: 'Email', value: '[first].[last][at][gmail.com]', href: 'mailto:saimun.shahee@gmail.com', icon: 'email' },
  { id: 'github', label: 'GitHub', value: '@swaymun', href: 'https://github.com/swaymun', icon: 'github' },
  { id: 'linkedin', label: 'LinkedIn', value: 'in/saimunshahee', href: 'https://linkedin.com/in/saimunshahee', icon: 'linkedin' },
  { id: 'twitter', label: 'X', value: '@saimunshahee', href: 'https://x.com/saimunshahee', icon: 'twitter' },
];

const sections = ['home', 'projects', 'resume'];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Saimun - Software Engineer Portfolio" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Saimun | Software Engineer</title>
  </head>
  <body>
    <!-- Boot Sequence -->
    <BootSequence gamertag="SwagMan67" />

    <!-- Status Bar -->
    <StatusBar />


    <div class="xbox-dashboard">
      <!-- Navigation -->
      <nav class="nav-bar">
        <ul class="nav-list">
          {sections.map((section, i) => (
            <li class="nav-item">
              <button
                class={`nav-link ${i === 0 ? 'active' : ''}`}
                data-section={i}
              >
                {section}
              </button>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Carousel Container -->
      <div class="carousel-container">
        <div class="carousel-track">

          <!-- HOME SECTION -->
          <section class="carousel-slide" data-section="home">
            <div class="home-content">
              <div class="home-avatar">
                <Avatar3D height="450px" />
              </div>
              <div class="home-tiles-row">
                <div class="intro-tile" tabindex="0">
                  <div class="intro-inner">
                    <p class="intro-text">Hi, my name is <strong>Saimun Shahee</strong>. I'm a software engineer at Meta based in New York. Previously I was at Cash App and Amazon. Outside of work I currently enjoy learning about agentic coding tools through vibe coding, playing tennis, and watching <a href="https://letterboxd.com/swaymun/" target="_blank" rel="noopener noreferrer">movies</a>!.</p>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- PROJECTS SECTION -->
          <section class="carousel-slide" data-section="projects">
            <div class="projects-content">
              {projects.map((project) => (
                <a href={project.link} class="project-tile" target="_blank" rel="noopener noreferrer">
                  <div class="project-inner">
                    <h2 class="project-title">{project.title}</h2>
                    <p class="project-desc">{project.description}</p>
                    <div class="project-tags">
                      {project.tags.map((tag) => <span class="tag">{tag}</span>)}
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>

          <!-- RESUME SECTION -->
          <section class="carousel-slide" data-section="resume">
            <div class="resume-grid">
              <!-- Row 1: Profile (3 cols) + Education (2 cols) -->
              <div class="grid-profile" tabindex="0">
                <img src="/logos/profile_pic.jpeg" alt={aboutProfile.name} class="profile-avatar" />
                <div class="profile-info">
                  <h1>{aboutProfile.name}</h1>
                  <p class="profile-title">{aboutProfile.title}</p>
                  <p class="profile-location">{aboutProfile.location}</p>
                </div>
              </div>

              <div class="grid-edu" tabindex="0">
                <img src="/logos/penn_state_transparent.png" alt={aboutProfile.education.school} class="edu-logo" />
                <div class="edu-info">
                  <span class="edu-school">{aboutProfile.education.school}</span>
                  <span class="edu-degree">{aboutProfile.education.degree}</span>
                  <span class="edu-period">{aboutProfile.education.period}</span>
                </div>
              </div>

              <!-- Row 2: 5 Experience tiles -->
              {aboutProfile.experience.map((exp) => (
                <div class="grid-exp">
                  <img src={logoImages[exp.logo]} alt={exp.company} class="exp-logo" />
                  <div class="exp-info">
                    <span class="exp-role">{exp.role}</span>
                    <span class="exp-company">{exp.company}</span>
                    <span class="exp-period">{exp.period}</span>
                  </div>
                </div>
              ))}

              <!-- Row 3: Contact icons in compact 2x2 grid -->
              <div class="grid-contacts-box">
                <a href="mailto:saimun.shahee@gmail.com" class="contact-icon" aria-label="Email">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                  </svg>
                </a>
                <a href="https://github.com/swaymun" target="_blank" rel="noopener noreferrer" class="contact-icon" aria-label="GitHub">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                    <path d="M9 18c-4.51 2-5-2-7-2"></path>
                  </svg>
                </a>
                <a href="https://linkedin.com/in/saimunshahee" target="_blank" rel="noopener noreferrer" class="contact-icon" aria-label="LinkedIn">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                    <rect width="4" height="12" x="2" y="9"></rect>
                    <circle cx="4" cy="4" r="2"></circle>
                  </svg>
                </a>
                <a href="https://x.com/saimunshahee" target="_blank" rel="noopener noreferrer" class="contact-icon" aria-label="X">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 4l11.733 16h4.267l-11.733 -16z"></path>
                    <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path>
                  </svg>
                </a>
              </div>
            </div>
          </section>

        </div>
      </div>

    </div>

    <!-- Modals and Overlays -->
    <AnnouncementsModal />
    <GuideOverlay />
    <AchievementToast />

    <script>
      import { audioManager, initAudioOnInteraction } from '@/lib/audio/AudioManager';
      import { achievementManager } from '@/lib/achievements/AchievementManager';

      // Initialize audio on first interaction
      initAudioOnInteraction();

      const track = document.querySelector('.carousel-track') as HTMLElement;
      const slides = document.querySelectorAll('.carousel-slide');
      const navLinks = document.querySelectorAll('.nav-link');
      const sections = ['home', 'projects', 'resume'];

      let currentIndex = 0;
      let isDragging = false;
      let startX = 0;
      let currentTranslate = 0;
      let prevTranslate = 0;
      let animationId: number;

      function getSlideWidth() {
        return window.innerWidth;
      }

      function setSlidePosition() {
        track.style.transform = `translateX(${currentTranslate}px)`;
      }

      function goToSlide(index: number, animate = true, playSound = true) {
        if (index < 0) index = 0;
        if (index >= slides.length) index = slides.length - 1;

        const changed = currentIndex !== index;
        currentIndex = index;
        currentTranslate = -index * getSlideWidth();
        prevTranslate = currentTranslate;

        track.style.transition = animate ? 'transform 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94)' : 'none';
        setSlidePosition();

        // Update active states
        navLinks.forEach((link, i) => link.classList.toggle('active', i === index));

        // Play blade switch sound
        if (changed && playSound && animate) {
          audioManager.play('blade-switch');
        }

        // Track section visit for achievements
        if (changed) {
          achievementManager.trackSectionVisit(sections[index]);
          // Dispatch event for bumper indicators
          window.dispatchEvent(new CustomEvent('section-changed', { detail: { index } }));
        }
      }

      // Nav click handlers
      navLinks.forEach((link) => {
        link.addEventListener('click', () => {
          const index = parseInt(link.getAttribute('data-section') || '0');
          goToSlide(index);
        });
      });

      // Keyboard navigation
      // Get all focusable tiles in each section
      function getFocusableTiles(): HTMLElement[] {
        const currentSlide = slides[currentIndex];
        const tiles = currentSlide?.querySelectorAll(
          '.intro-tile, .project-tile, .about-profile, .edu-tile, .exp-tile, .contact-tile, .contact-header'
        );
        return Array.from(tiles || []) as HTMLElement[];
      }

      let focusedTileIndex = -1;

      function focusTile(index: number) {
        const tiles = getFocusableTiles();
        if (tiles.length === 0) return;

        // Clamp index
        if (index < 0) index = 0;
        if (index >= tiles.length) index = tiles.length - 1;

        focusedTileIndex = index;
        tiles[index]?.focus();
        audioManager.play('hover');
      }

      function resetTileFocus() {
        focusedTileIndex = -1;
      }

      document.addEventListener('keydown', (e) => {
        // Don't handle if modal is open
        const modal = document.getElementById('announcements-modal');
        const guide = document.getElementById('guide-overlay');
        if (modal?.classList.contains('open') || guide?.classList.contains('open')) return;

        // Don't handle if boot sequence is active
        const boot = document.getElementById('boot-sequence');
        if (boot && !boot.classList.contains('removed')) return;

        const tiles = getFocusableTiles();

        switch (e.key) {
          case 'ArrowLeft':
            e.preventDefault();
            if (focusedTileIndex > 0) {
              // Move to previous tile
              focusTile(focusedTileIndex - 1);
            } else if (focusedTileIndex === 0 && currentIndex > 0) {
              // At leftmost tile, go to previous tab
              audioManager.play('blade-switch');
              goToSlide(currentIndex - 1, true, false);
              // Focus last tile in new section after transition
              setTimeout(() => {
                const newTiles = getFocusableTiles();
                focusTile(newTiles.length - 1);
              }, 300);
            } else if (focusedTileIndex === -1) {
              // No tile focused, focus the last tile
              focusTile(tiles.length - 1);
            }
            break;

          case 'ArrowRight':
            e.preventDefault();
            if (focusedTileIndex >= 0 && focusedTileIndex < tiles.length - 1) {
              // Move to next tile
              focusTile(focusedTileIndex + 1);
            } else if (focusedTileIndex === tiles.length - 1 && currentIndex < slides.length - 1) {
              // At rightmost tile, go to next tab
              audioManager.play('blade-switch');
              goToSlide(currentIndex + 1, true, false);
              // Focus first tile in new section after transition
              setTimeout(() => {
                focusTile(0);
              }, 300);
            } else if (focusedTileIndex === -1) {
              // No tile focused, focus the first tile
              focusTile(0);
            }
            break;

          case 'ArrowUp':
            e.preventDefault();
            if (focusedTileIndex > 0) {
              focusTile(focusedTileIndex - 1);
            } else if (focusedTileIndex === -1 && tiles.length > 0) {
              focusTile(tiles.length - 1);
            }
            break;

          case 'ArrowDown':
            e.preventDefault();
            if (focusedTileIndex < tiles.length - 1) {
              focusTile(focusedTileIndex + 1);
            } else if (focusedTileIndex === -1 && tiles.length > 0) {
              focusTile(0);
            }
            break;

          case 'Enter':
          case ' ':
            e.preventDefault();
            const focused = document.activeElement as HTMLElement;
            if (focused && tiles.includes(focused)) {
              audioManager.play('select');
              focused.click();
            } else if (tiles.length > 0) {
              // If no tile focused, focus first one
              focusTile(0);
            }
            break;

          case 'Escape':
          case 'Backspace':
            // Play back sound if something was focused
            if (focusedTileIndex >= 0) {
              audioManager.play('back');
              resetTileFocus();
              (document.activeElement as HTMLElement)?.blur();
            }
            break;
        }
      });

      // Touch/drag handling
      function touchStart(e: TouchEvent | MouseEvent) {
        isDragging = true;
        startX = 'touches' in e ? e.touches[0].clientX : e.clientX;
        track.style.transition = 'none';
        animationId = requestAnimationFrame(animation);
      }

      function touchMove(e: TouchEvent | MouseEvent) {
        if (!isDragging) return;
        const currentX = 'touches' in e ? e.touches[0].clientX : e.clientX;
        const diff = currentX - startX;
        currentTranslate = prevTranslate + diff;
      }

      function touchEnd() {
        isDragging = false;
        cancelAnimationFrame(animationId);

        const movedBy = currentTranslate - prevTranslate;
        const threshold = getSlideWidth() * 0.15;

        if (movedBy < -threshold) {
          goToSlide(currentIndex + 1);
        } else if (movedBy > threshold) {
          goToSlide(currentIndex - 1);
        } else {
          goToSlide(currentIndex);
        }
      }

      function animation() {
        setSlidePosition();
        if (isDragging) requestAnimationFrame(animation);
      }

      // Touch events
      track.addEventListener('touchstart', touchStart, { passive: true });
      track.addEventListener('touchmove', touchMove, { passive: true });
      track.addEventListener('touchend', touchEnd);

      // Mouse events for desktop drag
      track.addEventListener('mousedown', touchStart);
      track.addEventListener('mousemove', touchMove);
      track.addEventListener('mouseup', touchEnd);
      track.addEventListener('mouseleave', () => { if (isDragging) touchEnd(); });

      // Trackpad horizontal scroll
      let wheelTimeout: ReturnType<typeof setTimeout>;
      let wheelDelta = 0;

      document.addEventListener('wheel', (e) => {
        if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) {
          wheelDelta += e.deltaX;

          // Live visual feedback
          const tempTranslate = prevTranslate - wheelDelta * 0.5;
          track.style.transition = 'none';
          track.style.transform = `translateX(${tempTranslate}px)`;

          clearTimeout(wheelTimeout);
          wheelTimeout = setTimeout(() => {
            const threshold = 50;
            if (wheelDelta > threshold) {
              goToSlide(currentIndex + 1);
            } else if (wheelDelta < -threshold) {
              goToSlide(currentIndex - 1);
            } else {
              goToSlide(currentIndex);
            }
            wheelDelta = 0;
          }, 100);
        }
      }, { passive: true });

      // Handle resize
      window.addEventListener('resize', () => goToSlide(currentIndex, false, false));

      // Bumper navigation integration (kept for potential future use)
      window.addEventListener('bumper-navigate', ((e: CustomEvent) => {
        goToSlide(currentIndex + e.detail.direction);
      }) as EventListener);

      // Track contact link clicks for achievements + play sound
      document.querySelectorAll('.contact-icon').forEach((link) => {
        link.addEventListener('click', () => {
          audioManager.play('select');
          achievementManager.trackInteraction('contact-click');
        });
      });

      // Play sound on project tile clicks
      document.querySelectorAll('.project-tile').forEach((tile) => {
        tile.addEventListener('click', () => {
          audioManager.play('select');
        });
      });

      // Initialize achievement manager after boot
      window.addEventListener('boot-complete', () => {
        achievementManager.init();
        // Track initial section visit
        achievementManager.trackSectionVisit(sections[currentIndex]);
      });

      // Fallback init if boot was skipped
      setTimeout(() => {
        achievementManager.init();
        achievementManager.trackSectionVisit(sections[currentIndex]);
      }, 6500);
    </script>

    <style>
      .xbox-dashboard {
        min-height: 100vh;
        overflow: hidden;
        position: relative;
      }

      /* Navigation */
      .nav-bar {
        position: fixed;
        top: 12%;
        left: 0;
        right: 0;
        z-index: 100;
        display: flex;
        justify-content: center;
      }

      .nav-list {
        display: flex;
        flex-direction: row;
        gap: 56px;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .nav-item {
        display: inline-block;
      }

      .nav-link {
        font-size: 32px;
        font-weight: 300;
        color: #A0A0A0;
        background: none;
        border: none;
        cursor: pointer;
        padding: 12px 24px;
        transition: all 0.2s ease;
        text-transform: lowercase;
        font-family: 'Segoe UI', system-ui, sans-serif;
      }

      .nav-link:hover {
        color: #FFFFFF;
        transform: scale(1.05);
      }

      .nav-link.active {
        color: #FFFFFF;
        font-weight: 600;
        font-size: 42px;
      }

      /* Carousel */
      .carousel-container {
        width: 100vw;
        height: 100vh;
        overflow: hidden;
      }

      .carousel-track {
        display: flex;
        flex-direction: row;
        height: 100%;
        will-change: transform;
        cursor: grab;
      }

      .carousel-track:active {
        cursor: grabbing;
      }

      .carousel-slide {
        min-width: 100vw;
        width: 100vw;
        height: 100vh;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding-top: calc(12% + 36px);
        padding-left: 32px;
        padding-right: 32px;
        padding-bottom: 60px;
        box-sizing: border-box;
        flex-shrink: 0;
      }

      /* HOME */
      .home-content {
        display: flex;
        align-items: center;
        gap: 24px;
        max-width: 1200px;
        width: 100%;
      }

      .home-avatar {
        flex-shrink: 0;
        width: 320px;
      }

      @media (max-width: 900px) {
        .home-content {
          flex-direction: column;
          gap: 24px;
        }

        .home-avatar {
          width: 200px;
          height: 280px !important;
        }
      }

      @media (max-width: 600px) {
        .home-avatar {
          display: none;
        }
      }

      .home-tiles-row {
        display: flex;
        flex-direction: row;
        gap: 16px;
        flex: 1;
      }

      .home-tile {
        flex: 1;
        background: #107C10;
        display: flex;
        flex-direction: column;
      }

      .home-inner {
        padding: 40px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 16px;
      }

      .home-icon {
        width: 80px;
        height: 80px;
        color: #FFFFFF;
        opacity: 0.9;
      }

      .home-title {
        font-size: 30px;
        font-weight: 300;
        color: #FFFFFF;
        margin: 0;
      }

      .home-subtitle {
        font-size: 18px;
        color: #B3B3B3;
        margin: 0;
      }

      .intro-tile {
        flex: 1;
        background: #107C10;
        display: flex;
        flex-direction: column;
        max-width: 650px;
      }

      .intro-inner {
        padding: 48px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        flex: 1;
      }

      .intro-text {
        font-size: 24px;
        line-height: 1.7;
        color: #FFFFFF;
        margin: 0;
      }

      .intro-text strong {
        font-weight: 600;
      }

      /* PROJECTS */
      .projects-content {
        max-width: 700px;
        width: 100%;
      }

      .project-tile {
        background: #107C10;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: #FFFFFF;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .project-tile:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 12px 24px rgba(0,0,0,0.35);
      }

      .project-inner {
        padding: 32px;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .project-icon {
        width: 64px;
        height: 64px;
        opacity: 0.9;
      }

      .project-title {
        font-size: 28px;
        font-weight: 600;
        margin: 0;
      }

      .project-desc {
        font-size: 20px;
        opacity: 0.8;
        margin: 0;
        line-height: 1.5;
      }

      .project-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }

      .tag {
        font-size: 16px;
        background: rgba(255, 255, 255, 0.2);
        padding: 4px 12px;
        border-radius: 2px;
      }

      /* RESUME GRID - Xbox-style tight layout */
      .resume-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        grid-template-rows: auto auto auto;
        gap: 4px;
        max-width: 1100px;
        width: 100%;
      }

      /* Profile - spans 3 columns */
      .grid-profile {
        grid-column: span 3;
        background: #107C10;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 20px;
      }

      .profile-avatar {
        width: 90px;
        height: 90px;
        border-radius: 4px;
        object-fit: cover;
        flex-shrink: 0;
      }

      .profile-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .profile-info h1 {
        font-size: 26px;
        margin: 0;
        color: #FFFFFF;
        font-weight: 500;
      }

      .profile-info .profile-title {
        font-size: 18px;
        opacity: 0.9;
        margin: 0;
        color: #FFFFFF;
      }

      .profile-info .profile-location {
        font-size: 15px;
        opacity: 0.7;
        margin: 0;
        color: #FFFFFF;
      }

      /* Education - spans 2 columns */
      .grid-edu {
        grid-column: span 2;
        background: #107C10;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .edu-logo {
        width: 60px;
        height: 60px;
        object-fit: contain;
        flex-shrink: 0;
      }

      .edu-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
        color: #FFFFFF;
      }

      .edu-school {
        font-size: 18px;
        font-weight: 600;
      }

      .edu-degree {
        font-size: 14px;
        opacity: 0.9;
      }

      .edu-period {
        font-size: 13px;
        opacity: 0.7;
      }

      /* Experience tiles - 1 column each */
      .grid-exp {
        background: #107C10;
        padding: 20px 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 12px;
      }

      .exp-logo {
        width: 56px;
        height: 56px;
        object-fit: contain;
        flex-shrink: 0;
      }

      .exp-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
        color: #FFFFFF;
      }

      .exp-role {
        font-size: 13px;
        font-weight: 600;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        min-height: 2.6em;
        line-height: 1.3;
      }

      .exp-company {
        font-size: 13px;
        opacity: 0.9;
      }

      .exp-period {
        font-size: 12px;
        opacity: 0.7;
      }

      /* Contact icons - 1x4 horizontal row */
      .grid-contacts-box {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 4px;
        background: transparent;
      }

      .contact-icon {
        background: #107C10;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: background 0.15s ease;
        aspect-ratio: 1;
      }

      .contact-icon:hover {
        background: #0e6b0e;
      }

      .contact-icon svg {
        width: 20px;
        height: 20px;
        color: #FFFFFF;
      }

      /* Responsive */
      @media (max-width: 900px) {
        .resume-grid {
          grid-template-columns: repeat(3, 1fr);
        }

        .grid-profile {
          grid-column: span 3;
        }

        .grid-edu {
          grid-column: span 3;
        }
      }

      @media (max-width: 600px) {
        .resume-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .grid-profile {
          grid-column: span 2;
        }

        .grid-edu {
          grid-column: span 2;
        }

        .contact-grid {
          grid-template-columns: 1fr;
        }

        .nav-list {
          gap: 24px;
        }

        .nav-link {
          font-size: 18px;
        }

        .nav-link.active {
          font-size: 20px;
        }

        .home-tiles-row {
          flex-direction: column;
        }
      }

      @media (max-width: 500px) {
        .experience-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
