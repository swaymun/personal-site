---
import Site from "../layouts/Site.astro";
import Content from "../components/Content.astro";
import AlbumShelf from "../components/AlbumShelf.astro";
import GameShelf from "../components/GameShelf.astro";
import MovieShelf from "../components/MovieShelf.astro";
import {
  experience,
  companyUrls,
  projects,
  links,
} from "../data/site";
const posts = Object.values(
  import.meta.glob<{
    frontmatter: { title: string; date: string };
    url: string;
  }>("./writing/*.md", { eager: true }),
);
---

<Site
  ><article class="text-page home-page">
    <Content section="home" />
    <nav class="section-links" aria-label="On this page">
      {
        [
          "work",
          "projects",
          "movies",
          "music",
          "games",
          "writing",
          "links",
        ].map((s) => <a href={`#${s}`}>{s === "links" ? "Elsewhere" : s[0].toUpperCase() + s.slice(1)}</a>)
      }
    </nav>
    <section id="work">
      <h2>Work</h2><ul class="work-summary">
        {
          experience.map(([company, role, period, team]) => (
            <li>
              <a href={companyUrls[company]}>{company}</a> · {team}
              <br />
              <span class="muted">
                {role} · {period}
              </span>
            </li>
          ))
        }
      </ul><p>
        <a href="https://www.psu.edu/">Penn State</a> · BS Computer Science + Statistics <span class="muted"
          >(2016–2020)</span>
      </p>
    </section>
    <section id="projects">
      <h2>Projects</h2>{
        projects.map((p) => (
          <p>
            <a href={p.url}>{p.title}</a>
            <br />
            {p.description}
          </p>
        ))
      }
    </section>
    <section id="movies">
      <h2>Movies</h2><MovieShelf />
    </section>
    <section id="music">
      <h2>Music</h2><AlbumShelf />
    </section>
    <section id="games">
      <h2>Games</h2><GameShelf />
    </section>
    <section id="writing">
      <h2>Writing</h2>{
        posts.length ? (
          <ul>
            {posts.map((p) => (
              <li>
                <a href={p.url}>{p.frontmatter.title}</a>
              </li>
            ))}
          </ul>
        ) : (
          <p>Nothing published yet.</p>
        )
      }
    </section>
    <section id="links">
      <h2>Elsewhere</h2><div class="section-links">
        {links.map(([label, url]) => <a href={url}>{label}</a>)}
      </div>
    </section>
  </article></Site
>
